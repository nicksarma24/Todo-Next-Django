# Django
DJANGO_SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave empty to use local SQLite, or provide a PostgreSQL connection string
# DATABASE_URL=postgres://todo_user:todo_password@localhost:5432/todo_db
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth0
# Configure these values from your Auth0 Application/API settings
AUTH0_DOMAIN=your-auth0-domain
AUTH0_AUDIENCE=your-auth0-audience
